<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="Companion" Manufacturer="Companion" Language="1033"
           Version="$(var.Version)" UpgradeCode="E57AA071-C0BB-4266-B083-812F2A6F5685">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Companion is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />
    <Condition Message="Install Companion for the current user only.">NOT ALLUSERS</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="Companion Desktop" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MENUDIR" Name="Companion">
          <Component Id="StartMenu" Guid="615F101F-30FC-4E3A-9191-F91B57BA49BD">
            <Shortcut Id="OpenCompanion" Name="Companion" Target="[INSTALLFOLDER]Companion.exe" WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Companion\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <SetProperty Id="COMPANIONPROFILE" Value="[AppDataFolder]companion" Before="RemoveDailyIntake" Sequence="execute">NOT COMPANIONPROFILE</SetProperty>
    <CustomAction Id="RemoveDailyIntake" FileKey="CompanionExe" Execute="deferred" Impersonate="yes"
                  ExeCommand="--uninstall-daily-intake &quot;--user-data-dir=[COMPANIONPROFILE]&quot;" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RemoveDailyIntake" Before="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
    <Feature Id="Companion" Title="Companion" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Product>
</Wix>
